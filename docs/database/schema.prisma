datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  // Identity
  id           String   @id @default(uuid()) @db.Uuid

  // Business Fields
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.Text

  // Metadata
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  resumes      Resume[]

  @@map("users")
}

model Resume {
  // Identity
  id               String   @id @default(uuid()) @db.Uuid

  // Foreign Keys
  userId           String   @db.Uuid

  // Business Fields
  title            String?  @db.VarChar(255)
  originalFileName String   @db.Text
  mimeType         String   @db.VarChar(100)
  fileSize         Int
  pdfUrl           String   @db.Text

  /// Plain text extracted from the uploaded PDF.
  extractedText    String   @db.Text

  /// Structured representation of the resume produced by the Parsing Module.
  structuredResume Json     @db.JsonB

  // Metadata
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses         Analysis[]

  @@index([userId])
  @@map("resumes")
}

model Analysis {
  // Identity
  id                 String   @id @default(uuid()) @db.Uuid

  // Foreign Keys
  resumeId           String   @db.Uuid

  // Business Fields

  /// Original job description pasted by the user.
  jobDescriptionText String   @db.Text

  /// Parsed and normalized representation of the job description.
  parsedJob          Json     @db.JsonB

  /// Snapshot of the resume used for this analysis.
  /// Preserves historical accuracy even if the resume changes later.
  resumeSnapshot     Json     @db.JsonB

  /// Final output generated by the Rule Engine and AI Module.
  analysisResult     Json     @db.JsonB

  // Metadata
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  resume             Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([createdAt(sort: Desc)])

  @@map("analyses")
}