PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

COOKIE_MAX_AGE=900000
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_COOKIE_MAX_AGE=604800000

DB_POOL_MAX=10

DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
JWT_SECRET="replace-with-a-long-random-secret"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=

# Google OAuth ("Sign in with Google"). Create a Web application OAuth client
# at console.cloud.google.com -> APIs & Services -> Credentials.
# GOOGLE_CALLBACK_URL must be byte-identical to an "Authorized redirect URI"
# registered on that client — scheme, host, port, path and trailing slash all
# count, or Google returns redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
