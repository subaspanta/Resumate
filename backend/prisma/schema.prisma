datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @db.Timestamp(6)

  resumes       Resume[]
  refreshTokens RefreshToken[]
    analyses      Analysis[]   // ← add this


  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  revokedAt DateTime? @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Resume {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  title            String   @db.VarChar(255)
  originalFileName String   @db.Text
  mimeType         String   @db.VarChar(100)
  fileSize         Int
  fileUrl          String   @db.Text
  rawText          String   @db.Text
  structuredResume Json     @db.JsonB
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @db.Timestamp(6)

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]

  @@index([userId])
  @@map("resumes")
}

model Analysis {
  id             String   @id @default(uuid()) @db.Uuid
  resumeId       String   @db.Uuid
    userId         String   @db.Uuid
  jobDescription String   @db.Text
  parsedJob      Json     @db.JsonB
  resumeSnapshot Json     @db.JsonB
  analysisResult Json     @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([resumeId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([resumeId, createdAt(sort: Desc)])
  @@map("analyses")
}
